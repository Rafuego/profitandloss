# NOTE: The Supabase connection is currently HARDCODED in lib/supabase.ts —
# these env vars are not read. See "Supabase Connection" in CLAUDE.md.
# Kept for reference in case the app is ever switched back to env-based config.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mercury invoicing (server-side only — read by app/api/mercury/route.ts, never
# shipped to the browser). Use a READ-ONLY token; include the "secret-token:" prefix.
# Set this in Vercel → Project → Settings → Environment Variables (not committed).
MERCURY_API_TOKEN=secret-token:mercury_production_...
